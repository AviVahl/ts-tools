{
  "name": "ts-tools",
  "description": "TypeScript Tools for Node.js",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "clean": "node ./scripts/clean.js",
    "build": "tsc --build",
    "watch": "npm run build -- -w",
    "pretest": "npm run build",
    "test": "node --test --enable-source-maps \"packages/*/dist/test/**/*.test.{js,mjs}\"",
    "prettify": "prettier . --write"
  },
  "devDependencies": {
    "@types/node": "24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.1.0-beta"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "author": {
    "name": "Avi Vahl",
    "url": "https://github.com/AviVahl"
  },
  "license": "MIT",
  "private": true
}
